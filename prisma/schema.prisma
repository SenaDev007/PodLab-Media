// PodLab Media — Schéma BDD (SQLite)
// Back-office : CRM Sponsoring, Audience Newsletter, Réservations Studios,
// Billetterie, Analytics d'audience, Chiffres clés éditables, Paramètres admin.
// Modèle back-office aligné sur l'architecture WinAgro (SenaDev007/win-Agro).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Abonnés Newsletter "PodLab Business Brief"
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  segment   String   @default("general") // finance | success-stories | strategie | general
  source    String   @default("newsletter") // newsletter | episode-pdf | sponsoring
  createdAt DateTime @default(now())
}

// Leads Sponsoring B2B — pipeline CRM
model Lead {
  id           String   @id @default(cuid())
  company      String
  contactName  String
  email        String
  phone        String?
  budgetRange  String // "A" (< 500k) | "B" (500k-1M) | "C" (> 1M)
  budgetLabel  String   @default("")
  message      String?
  status       String   @default("nouveau") // nouveau | kit_envoye | rdv_cale | signe
  highPriority Boolean  @default(false)
  mediaKitSent Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Réservations de studios (Cotonou / Abidjan)
model Booking {
  id            String   @id @default(cuid())
  city          String // cotonou | abidjan
  formula       String // audio | video4k | cle-en-main
  formulaLabel  String   @default("")
  date          String // YYYY-MM-DD
  slot          String // ex: "09:00 – 12:00"
  clientName    String
  email         String
  phone         String
  paymentMethod String // mobile-money | carte
  amount        Int // en F CFA
  status        String   @default("confirme")
  createdAt     DateTime @default(now())
}

// Billets Événements (masterclasses & enregistrements publics)
model TicketPurchase {
  id        String   @id @default(cuid())
  eventId   String
  eventName String
  quantity  Int
  buyerName String
  email     String
  amount    Int
  createdAt DateTime @default(now())
}

// Passages VIP à l'antenne — page /invitation (invités de prestige)
// Prise de rendez-vous directe, sans échange d'e-mails : la référence de
// confirmation est générée immédiatement côté serveur.
model InvitationBooking {
  id        String   @id @default(cuid())
  city      String // cotonou | abidjan
  date      String // YYYY-MM-DD
  slot      String // ex: "09:00 – 12:00"
  guestName String
  role      String   @default("") // fonction / entreprise de l'invité
  email     String
  phone     String
  topic     String   @default("") // sujet souhaité pour l'interview
  format    String   @default("standard") // standard | long | sur-mesure
  ref       String   @default("") // référence PL-VIP-XXXX
  status    String   @default("vip-confirme")
  createdAt DateTime @default(now())
}

// ─── Paramètres du back-office (identifiants admin surchargeables, etc.) ─────
model AdminSetting {
  key   String @id
  value String

  @@map("admin_settings")
}

// ─── Chiffres clés du site public — pilotés depuis le back-office ────────────
// Le hero de la page d'accueil lit ces valeurs (avec repli sur les défauts).
model SiteStat {
  key     String @id // ecoutes_trim | decideurs | studios | videos
  value   Int
  label   String
  subText String @map("sub_text")
  prefix  String @default("")
  format  String @default("full") // full | compact

  @@map("site_stats")
}

// ─── Analytics d'audience — pageviews trackés depuis le site public ──────────
model PageView {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  sessionToken String   @map("session_token")
  path         String
  referrer     String?
  userAgent    String?  @map("user_agent")
  deviceType   String?  @map("device_type")
  browser      String?
  country      String?
  city         String?
  utmSource    String?  @map("utm_source")
  utmMedium    String?  @map("utm_medium")
  utmCampaign  String?  @map("utm_campaign")

  @@index([timestamp])
  @@map("page_views")
}

// ─── Sessions actives — heartbeat (visiteurs en ligne) ───────────────────────
model ActiveSession {
  token       String   @id
  lastSeen    DateTime @default(now()) @map("last_seen")
  createdAt   DateTime @default(now()) @map("created_at")
  deviceType  String?  @map("device_type")
  browser     String?
  country     String?
  city        String?
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")

  @@map("active_sessions")
}
